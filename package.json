{
  "name": "mindmirror",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore \"node test/firestore.rules.test.mjs\"",
    "test:mbti": "tsc -p tsconfig.test.json && node test/mbti.test.mjs",
    "test": "npm run lint && npm run test:mbti && npm run test:rules"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.14.0",
    "firebase-tools": "^15.36.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.6"
  },
  "overrides": {
    "@firebase/rules-unit-testing": {
      "firebase": "$firebase"
    }
  }
}
