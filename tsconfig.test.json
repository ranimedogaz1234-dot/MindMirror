{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": false,
    "outDir": ".test-build",
    "rootDir": "src"
  },
  "include": [
    "src/mbti/**/*.ts",
    "src/i18n/**/*.ts"
  ]
}
